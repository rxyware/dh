	if not cfg.rapidFireEnabled then return end  
	char.ChildAdded:Connect(function(tool)  
		if tool:IsA("Tool") then task.wait(0.1); patchtool(tool) end  
	end)  
	local gun=getrapidgun(); if gun then patchtool(gun) end  
end  
  
