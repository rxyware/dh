-- pull resistance: tracks how fast the player is moving the mouse so the camlock can back off while they drag away
cfg._pullAccum, cfg._pullVel, cfg._pullRes = Vector2.new(0,0), 0, 0
cfg._pullConn = UIS.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement then
		cfg._pullAccum = cfg._pullAccum + Vector2.new(input.Delta.X, input.Delta.Y)
	end
end)

-- Velocity Pull Resistance: the faster you move the mouse (px/sec), the more the camlock lets go.
--   resistance target = clamp(mouseVelocity / VelocityForFull, 0, 1) * Strength
--   it ramps up fast, and eases back down at the Recovery rate once you stop pulling
function RW.updatePullVel(dt)
	local acc = cfg._pullAccum; cfg._pullAccum = Vector2.new(0,0)
	local speed = dt > 0 and acc.Magnitude/dt or 0
	cfg._pullVel = cfg._pullVel + (speed - cfg._pullVel) * (1 - math.exp(-dt*30))
	local target = math.clamp(cfg._pullVel / math.max(cfg.camlockPullVelRef, 1), 0, 1) * cfg.camlockPullResistStrength
	local rate = target > cfg._pullRes and 30 or cfg.camlockPullRecover
	cfg._pullRes = cfg._pullRes + (target - cfg._pullRes) * (1 - math.exp(-dt*rate))
end

function RW.applyPull(pred)
	local res = cfg._pullRes
	if res <= 0.001 then return pred end
	local camPos = cam.CFrame.Position; local offs = pred - camPos; local dist = offs.Magnitude
	if dist <= 0.001 then return pred end
	local blended = cam.CFrame.LookVector:Lerp(offs.Unit, 1 - res)
	if blended.Magnitude > 0.001 then return camPos + blended.Unit * dist end
	return pred
end

