-- A target is any character-like model in the world that is NOT a connected player's
-- character: NPC bots, dummies, and leftover player rigs that stayed in the world after the
-- player left. It counts if it has a Humanoid OR the usual rig parts (HumanoidRootPart/Torso + Head),
-- so rigs without a Humanoid work too.
-- They are tracked from DescendantAdded / DescendantRemoving instead of scanning
-- workspace:GetDescendants() every frame (that scan is what was destroying FPS).
-- The tracker only runs while "Target Bots" is on for camlock or silent aim.
RW.botSet = {}     -- [model] = Humanoid, or true when the rig has no Humanoid
RW.botConns = {}

function RW.botRoot(char)
	return char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
		or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Head")
end

function RW.botAlive(char, hum)
	if not char or not char.Parent then return false end
	if hum == true then return true end
	return hum.Parent ~= nil and hum.Health > 0
end

function RW.botCandidate(model)
	if not model or not model.Parent or not model:IsA("Model") then return end
	if Players:GetPlayerFromCharacter(model) then return end            -- connected players are handled separately
	if model:IsDescendantOf(cam) then return end                        -- first-person viewmodels etc.
	if lp.Character and (model == lp.Character or model:IsDescendantOf(lp.Character)) then return end
	local anc = model.Parent
	while anc and anc ~= workspace do                                   -- parts of a player's own rig
		if anc:IsA("Model") and Players:GetPlayerFromCharacter(anc) then return end
		anc = anc.Parent
	end
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum then
		local head = model:FindFirstChild("Head")
		local body = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso")
		if not (head and body and head:IsA("BasePart") and body:IsA("BasePart")) then return end
	end
	RW.botSet[model] = hum or true
end

function RW.botTrackerStart()
	if RW.botConns.add then return end
	RW.botConns.add = workspace.DescendantAdded:Connect(function(o)
		if o:IsA("Humanoid") then task.defer(RW.botCandidate, o.Parent)
		elseif o.Name == "HumanoidRootPart" and o:IsA("BasePart") then task.delay(0.25, RW.botCandidate, o.Parent) end
	end)
	RW.botConns.rem = workspace.DescendantRemoving:Connect(function(o) RW.botSet[o] = nil end)
	-- one-time scan for rigs that already exist (yields, so it never freezes the game)
	task.spawn(function()
		local n = 0
		for _, o in ipairs(workspace:GetDescendants()) do
			if o:IsA("Humanoid") or (o.Name == "HumanoidRootPart" and o:IsA("BasePart")) then RW.botCandidate(o.Parent) end
			n += 1
			if n % 3000 == 0 then task.wait() end
		end
	end)
end

function RW.botTrackerStop()
	for k, c in pairs(RW.botConns) do pcall(function() c:Disconnect() end); RW.botConns[k] = nil end
	RW.botSet = {}
	if RW.clearBotESP then RW.clearBotESP() end
end

function RW.botTrackerUpdate()
	if cfg.camlockTargetBots or cfg.silentAimTargetBots then RW.botTrackerStart() else RW.botTrackerStop() end
end

-- adds every living, on-screen bot in range to the target list (same entry shape as players)
function RW.addBotTargets(results, distLimit, center, fovR)
	local camPos = cam.CFrame.Position
	for char, hum in pairs(RW.botSet) do
		if not RW.botAlive(char, hum) then
			RW.botSet[char] = nil
		elseif not Players:GetPlayerFromCharacter(char) then
			local hrp = RW.botRoot(char)
			if hrp and (hrp.Position - camPos).Magnitude <= distLimit then
				local sp, on = cam:WorldToViewportPoint(hrp.Position)
				if on then
					local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
					if not fovR or d <= fovR then
						table.insert(results, {char=char, player=nil, isBot=true, dist=d, hrp=hrp})
					end
				end
			end
		end
	end
end


