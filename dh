-- Auto Stomp (IIFE, same logic as original)
;(function()
    local plrs = game:GetService("Players")
    local rs   = game:GetService("RunService")
    local rps  = game:GetService("ReplicatedStorage")
    local lp   = plrs.LocalPlayer
    local state = { on=false, running=false, ret=nil, target=nil }
    cfg._stomp = state
    local function isKO(char)
        local b = char and char:FindFirstChild("BodyEffects")
        local ko = b and b:FindFirstChild("K.O")
        local dead = b and b:FindFirstChild("Dead")
        return ko ~= nil and ko.Value == true and not (dead and dead.Value == true), dead
    end
    local function getTarget(myPos)
        local best, bestD = nil, math.huge
        for _,p in ipairs(plrs:GetPlayers()) do
            if p ~= lp and p.Character then
                local ut = p.Character:FindFirstChild("UpperTorso")
                if ut and isKO(p.Character) then
                    local d = (ut.Position - myPos).Magnitude
                    if d < bestD then bestD = d; best = p end
                end
            end
        end
        return best
    end
    local function startLoop()
        if state.running then return end
        state.running = true
        task.spawn(function()
            pcall(function()
                local mainevent = rps:WaitForChild("MainEvent", 5)
                if not mainevent then return end
                while state.on do
                    local c = lp.Character
                    local hrp = c and c:FindFirstChild("HumanoidRootPart")
                    local hum = c and c:FindFirstChildWhichIsA("Humanoid")
                    if not (c and hrp and hum) or hum.Health <= 0 or isKO(c) then
                        state.ret = nil; state.target = nil; task.wait(0.1); continue
                    end
                    if not state.target then state.target = getTarget(hrp.Position) end
                    local t = state.target; local tc = t and t.Character
                    if not t or not tc or not isKO(tc) then
                        if state.ret then hrp.CFrame = state.ret end
                        state.ret = nil; state.target = nil; task.wait(); continue
                    end
                    local ut = tc:FindFirstChild("UpperTorso")
                    if ut then
                        if not state.ret then state.ret = hrp.CFrame end
                        hum.Sit = false; hum.PlatformStand = false
                        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.CFrame = CFrame.new(ut.Position + Vector3.new(0,3.5,0))
                        rs.RenderStepped:Wait()
                        for _ = 1,5 do mainevent:FireServer("Stomp") end
                        hrp.CFrame = state.ret
                    end
                    task.wait()
                end
            end)
            local c = lp.Character
            local hrp = c and c:FindFirstChild("HumanoidRootPart")
            if state.ret and hrp then hrp.CFrame = state.ret end
            state.ret = nil; state.target = nil; state.running = false
        end)
    end
    MoveSec:Toggle({ Title = "Auto Stomp", Default = false, Tooltip = "Teleports to knocked players, stomps, then returns you", Flag = "AutoStompEn", Callback = function(v) state.on = v; if v then startLoop() end end})
end)()

