    -- fog
    cfg.fogEnabled = false
    Lighting.FogStart = origL.FogStart; Lighting.FogEnd = origL.FogEnd; Lighting.FogColor = origL.FogColor

    -- skybox
    if rotatingSkyConn then rotatingSkyConn:Disconnect(); rotatingSkyConn = nil end
