-- cached lookup; only waits (once) when the wraps have not replicated yet
local function scGetModel(weaponName, skinName, timeout)
	if not skinName or skinName=="" or skinName=="None" then return nil end
	local key = weaponName.."|"..skinName
	local hit = RW.scCache[key]
	if hit and hit.Parent then return hit end
	local rsv = game:GetService("ReplicatedStorage")
	local wraps = rsv:FindFirstChild("Wraps")
	local folder = wraps and wraps:FindFirstChild("["..weaponName.."]")
	local m = folder and folder:FindFirstChild(skinName)
	if not m then
		wraps = wraps or rsv:WaitForChild("Wraps", timeout or 3)
		folder = wraps and wraps:WaitForChild("["..weaponName.."]", timeout or 3)
		m = folder and folder:FindFirstChild(skinName)
	end
	if m then RW.scCache[key] = m end
	return m
end

local function scApplyTool(tool)
	if not tool or not tool:IsA("Tool") then return end
	local wn=tool.Name:match("^%[(.+)%]$"); if not wn then return end
	local key=RW.scToolMap[wn]; if not key then return end
	local skin=scSkins[key]
	if not skin or skin=="None" then return end
	local model=scGetModel(wn, skin)
	if model then pcall(scApplyOnHolder, tool, model) else scRemoveSkin(tool) end
end

local function scAnyActive()
	for _,v in pairs(scSkins) do if v and v~="None" then return true end end
	return false
end

local function scApplyFolder(folder, key)
	local wn=RW.scWeaponMap[key]
	local skin=scSkins[key]
	if not skin or skin=="None" then scRemoveSkin(folder)
	elseif wn then
		local model=scGetModel(wn, skin)
		if model then pcall(scApplyOnHolder, folder, model) else scRemoveSkin(folder) end
	end
end

local function scApplyChar(char)
	if not char then return end
	if not scAnyActive() then return end
	for _,tool in ipairs(char:GetChildren()) do
		if tool:IsA("Tool") then scApplyTool(tool) end
	end
	for handleName,key in pairs(scHandleMap) do
		local folder=char:FindFirstChild(handleName)
		if folder then scApplyFolder(folder, key) end
	end
end

-- resolve + prepare every selected skin ahead of time, so equipping has nothing left to look up
function RW.scPrewarm()
	for key,skin in pairs(scSkins) do
		if skin and skin ~= "None" then
			task.spawn(function()
				local wn = RW.scWeaponMap[key]
				local model = wn and scGetModel(wn, skin)
				if model and not RW.scTemplates[model] then
					local t = model:Clone()
					if scIsBasePart(RW.scEnsurePrimary(t)) then RW.scPrepParts(t, false); RW.scTemplates[model] = t end
				end
			end)
		end
	end
end

-- Hook every tool's Equipped event and apply the skin right after it fires (task.defer = same frame,
-- but outside the engine's equip step so the tool itself is never touched mid-equip).
local function scHookTool(tool)
	if not tool:IsA("Tool") or RW.scHooked[tool] then return end
	RW.scHooked[tool] = true
	tool.Equipped:Connect(function()
		if scAnyActive() then task.defer(scApplyTool, tool) end
	end)
end

function RW.scWatchChar(char)
	if RW.scHooked[char] then return end
	RW.scHooked[char] = true
	for _,c in ipairs(char:GetChildren()) do scHookTool(c) end
	char.ChildAdded:Connect(function(child)
		if child:IsA("Tool") then
			scHookTool(child)
			if scAnyActive() then task.defer(scApplyTool, child) end
		elseif scHandleMap[child.Name] and scAnyActive() then
			local key = scHandleMap[child.Name]
			task.defer(function()
				if child.Parent and child:FindFirstChild("Handle") then scApplyFolder(child, key) end
			end)
		end
	end)
end

function RW.scWatchBackpack()
	local bp = lp:FindFirstChildOfClass("Backpack") or lp:WaitForChild("Backpack", 5)
	if not bp or RW.scHooked[bp] then return end
	RW.scHooked[bp] = true
	for _,c in ipairs(bp:GetChildren()) do scHookTool(c) end
	bp.ChildAdded:Connect(scHookTool)
end

