function RW.getClosestBodyPart(char)  
	local closestPart, shortestDist = nil, math.huge  
	local mousePos = UIS:GetMouseLocation()  
	for _, part in pairs(RW.getBodyParts(char)) do  
		if part then  
			local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)  
			local dist  
			if onScreen then  
				dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude  
			else  
				dist = (cam.CFrame.Position - part.Position).Magnitude + 10000  
			end  
			if dist < shortestDist then shortestDist = dist; closestPart = part end  
		end  
	end  
	return closestPart  
end  
  
function RW.getSilentAimPart(char)  
	if not char then return nil end  
	if cfg.silentAimClosestPart then  
		return RW.getClosestBodyPart(char) or RW.botRoot(char)  
	end
	local pn = cfg.silentAimPart  
	local hum = char:FindFirstChildOfClass("Humanoid")  
	if cfg.silentAimUseAirPart and hum and hum.FloorMaterial == Enum.Material.Air then  
		pn = cfg.silentAimAirPart  
	end  
	return char:FindFirstChild(pn) or char:FindFirstChild("HumanoidRootPart") or RW.botRoot(char)  
end  
  
function RW.getSilentAimTarget(part)  
	if not part then return nil end  
	local char = part.Parent  
	local hum = char and char:FindFirstChildOfClass("Humanoid")  
	if not char or (not hum and not RW.botSet[char]) then return nil end
	if hum and hum.Health <= 0 then return nil end
	if cfg.silentAimKOCheck then  
		local be = char:FindFirstChild("BodyEffects")  
		if be then local ko = be:FindFirstChild("K.O") or be:FindFirstChild("KO"); if ko and ko.Value then return nil end end  
	end  
	if cfg.silentAimTeamCheck then  
		local p = Players:GetPlayerFromCharacter(char)  
		if p and sameTeam(p) then return nil end  
	end  
	local dist = (part.Position - cam.CFrame.Position).Magnitude  
	if dist > cfg.silentAimMaxDist then return nil end  
	if cfg.silentAimWallCheck and wallBetween(part.Position,char) then return nil end  
	return part  
end  
  
function RW.getSilentAimHitPart()  
	local target = RW.closestToCursorSilent(cfg.silentAimFOV, cfg.silentAimTeamCheck, cfg.silentAimMaxDist)  
	if not target then return nil end  
	local part = RW.getSilentAimPart((type(target) == "table" and target.char) or target.Character)  
	return RW.getSilentAimTarget(part)  
end  
  
function RW.getSilentAimPred(part)  
	local vel = part.AssemblyLinearVelocity
	local px, py
	if cfg.silentAimAutoPred then
		local pingScale = RW.getPing() / 1000
		px = pingScale * 1.2
		py = pingScale * 1.2
	else
		px = cfg.silentAimPredX
		py = cfg.silentAimPredY
	end
	return part.Position + Vector3.new(  
		vel.X * px,  
		vel.Y * py,  
		vel.Z * px  
	)  
end  
  
