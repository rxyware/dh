-- bot ESP drawings: created for nearby tracked bots, removed when they die / leave / the option is off
function RW.clearBotESP()
	for char, d in pairs(botEspData) do
		for _, k in ipairs({"box","name","dist","hbg","hfill"}) do pcall(function() d[k]:Remove() end) end
		botEspData[char] = nil
	end
end

function RW.syncBotESP()
	if not (cfg.camlockTargetBots or cfg.silentAimTargetBots) then RW.clearBotESP(); return end
	local now = os.clock()
	if now - (RW._botEspT or 0) < 0.3 then return end
	RW._botEspT = now
	local camPos, list = cam.CFrame.Position, {}
	for char, hum in pairs(RW.botSet) do
		if RW.botAlive(char, hum) then
			local hrp = RW.botRoot(char)
			if hrp then
				local dist = (hrp.Position - camPos).Magnitude
				if dist <= cfg.espMaxDist then list[#list+1] = {char = char, dist = dist} end
			end
		end
	end
	table.sort(list, function(x, y) return x.dist < y.dist end)
	local keep = {}
	for i = 1, math.min(#list, 25) do keep[list[i].char] = true end
	for char, d in pairs(botEspData) do          -- drop drawings of rigs that are no longer in the nearest set
		if not keep[char] then
			for _, k in ipairs({"box","name","dist","hbg","hfill"}) do pcall(function() d[k]:Remove() end) end
			botEspData[char] = nil
		end
	end
	for char in pairs(keep) do
		if not botEspData[char] then
			botEspData[char] = {
				box  = newDraw("Square",{Thickness=1,Color=Color3.fromRGB(255,120,0),Filled=false,Visible=false}),
				name = newDraw("Text",{Size=11,Color=Color3.fromRGB(255,200,100),Outline=true,Center=true,Visible=false,Text="[BOT]"}),
				dist = newDraw("Text",{Size=10,Color=Color3.fromRGB(200,150,80),Outline=true,Center=true,Visible=false}),
				hbg  = newDraw("Square",{Thickness=1,Color=Color3.fromRGB(20,20,20),Filled=true,Visible=false}),
				hfill= newDraw("Square",{Thickness=1,Color=Color3.fromRGB(255,180,0),Filled=true,Visible=false}),
			}
		end
	end
end

