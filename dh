local function scIsBasePart(x) return typeof(x)=="Instance" and x:IsA("BasePart") end

function RW.scEnsurePrimary(model)
	if not(model and model:IsA("Model")) then return end
	if not scIsBasePart(model.PrimaryPart) then
		local f=model:FindFirstChildWhichIsA("BasePart"); if f then model.PrimaryPart=f end
	end
	return model.PrimaryPart
end

function RW.scPrepParts(model, isKnife)
	for _,p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then p.CanCollide=false;p.Anchored=false;p.Massless=true end
		if isKnife and p:IsA("MeshPart") then
			local sa=p:FindFirstChildOfClass("SurfaceAppearance"); if sa then sa:Destroy() end
			if p.TextureID=="" then local n=p.Name:lower(); if n:find("box") or n:find("cube") or n:find("hit") then p.Transparency=1 end end
		end
	end
end

function RW.scWeld(a,b)
	if scIsBasePart(a) and scIsBasePart(b) then
		local w=Instance.new("WeldConstraint"); w.Part0=a; w.Part1=b; w.Parent=a
	end
end

RW.scCache = {}                                   -- "Weapon|Skin" -> model in ReplicatedStorage.Wraps
RW.scTemplates = setmetatable({}, {__mode = "k"})  -- model -> ready-to-clone copy (already prepared)
RW.scHooked    = setmetatable({}, {__mode = "k"})  -- tools / characters / backpacks we already listen to

local function scApplyOnHolder(holder, skinmodel)
	if not holder or not skinmodel then return end
	local handle=holder:FindFirstChild("Handle"); if not scIsBasePart(handle) then return end
	local old=holder:FindFirstChild("SkinModel"); if old then old:Destroy() end
	local isKnife = holder.Name:find("Knife") and true or false
	local template = RW.scTemplates[skinmodel]
	if not template then
		template = skinmodel:Clone()
		if not scIsBasePart(RW.scEnsurePrimary(template)) then return end
		RW.scPrepParts(template, isKnife)
		RW.scTemplates[skinmodel] = template
	end
	local clone = template:Clone(); clone.Name="SkinModel"
	clone.Parent=holder; clone:PivotTo(handle.CFrame)
	for _,p in ipairs(clone:GetDescendants()) do if p:IsA("BasePart") then RW.scWeld(handle,p) end end
	handle.Transparency=1
	-- put the real handle back when the tool is unequipped/dropped (hooked once per tool)
	if holder:IsA("Tool") and not RW.scHooked[holder] then
		RW.scHooked[holder] = true
		holder.Unequipped:Connect(function()
			local sm=holder:FindFirstChild("SkinModel")
			if sm then sm:Destroy() end
			local h=holder:FindFirstChild("Handle")
			if scIsBasePart(h) then h.Transparency=0 end
		end)
	end
end

local function scRemoveSkin(holder)
	if not holder then return end
	local old=holder:FindFirstChild("SkinModel"); if old then old:Destroy() end
	local handle=holder:FindFirstChild("Handle"); if scIsBasePart(handle) then handle.Transparency=0 end
end

