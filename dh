	d.name=newDraw("Text",{Size=13,Color=cfg.espNameColor,Outline=true,Center=true,Visible=false,Font=2})  
	d.dist=newDraw("Text",{Size=12,Color=Color3.new(1,1,1),Outline=true,Center=true,Visible=false,Font=2,Text="[0m]"})  
	-- health bar: black background line + coloured fill line (message.txt style)
	d.hpBgLine=newDraw("Line",{Thickness=4,Color=Color3.new(0,0,0),Visible=false})
	d.hpLine=newDraw("Line",{Thickness=2,Color=cfg.espHealthColor,Visible=false})
	-- keep old square-based hp fields for removeESP compat (unused but allocated)
	d.hbg=newDraw("Square",{Thickness=1,Color=Color3.fromRGB(20,20,20),Filled=true,Visible=false})  
	d.hfill=newDraw("Square",{Thickness=1,Color=cfg.espHealthColor,Filled=true,Visible=false})  
	d.headDot=newDraw("Circle",{Thickness=1,NumSides=20,Radius=4,Color=cfg.espHeadDotColor,Filled=false,Visible=false})  
	d.tracer=newDraw("Line",{Thickness=1,Color=cfg.espTracerColor,Visible=false})  
	d.bones={}; for _=1,#RW.BONES do table.insert(d.bones,newDraw("Line",{Thickness=1,Color=cfg.espBoneColor,Visible=false})) end  
	d.billboard=nil  
	espData[plr]=d
	-- on respawn: rebuild the ESP entry cleanly so the render loop picks up the new character
	plr.CharacterAdded:Connect(function(char)
		if not cfg.esp then return end
		task.defer(function()
			removeESP(plr)
			char:WaitForChild("HumanoidRootPart", 5)
			task.wait(0.1)
			createESP(plr)
		end)
	end)
end  
  
function RW.buildBillboard(plr, d)  
	if d.billboard then pcall(function() d.billboard:Destroy() end); d.billboard=nil end  
	local char=plr.Character; if not char then return end  
	local hrp=char:FindFirstChild("HumanoidRootPart"); if not hrp then return end  
	local bb=Instance.new("BillboardGui")  
	bb.Name="RaywareESPName"; bb.AlwaysOnTop=true  
	bb.Size=UDim2.new(0,200,0,30); bb.StudsOffset=Vector3.new(0,3,0)  
	bb.Adornee=hrp; bb.Parent=hrp  
