local function _thumb(uid, px) return ("rbxthumb://type=AvatarHeadShot&id=%d&w=%d&h=%d"):format(uid, px, px) end
local function fmtAge(d)
    if d >= 365 then return ("%d days (%.1f yr)"):format(d, d / 365) end
    return d == 1 and "1 day" or (tostring(d) .. " days")
end

-- search input
local searchInput = DirSec:Input({ Title = "Search", Placeholder = "Search players...", Flag = "PlayerSearch", Finished = false })

-- player dropdown (populated dynamically)
local function getAllPlayers()
    local all = {}
    for _, p in ipairs(Players:GetPlayers()) do if p ~= lp then table.insert(all, p.DisplayName) end end
    return all
end
local playerDrop = DirSec:Dropdown({ Title = "Select Player", Values = getAllPlayers(), Default = "", Flag = "SelectedPlayer", AllowNone = true, Callback = function(name)
    if not name then selectedPlayer = nil; updateProfile(); return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.DisplayName == name and p ~= lp then selectedPlayer = p; break end
    end
    updateProfile()
end})

-- count label
local countLabel = DirSec:Label({ Text = "0 players" })

-- refresh function
local function refreshPlayerList()
    local q = ""
    if searchInput and searchInput.Get then q = (searchInput:Get() or ""):lower() end
    local all = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp then
            local match = q == "" or p.Name:lower():find(q, 1, true) ~= nil or p.DisplayName:lower():find(q, 1, true) ~= nil
            if match then table.insert(all, p.DisplayName) end
        end
    end
    playerDrop:Refresh(all, true)
    countLabel:Set(#all .. " players")
end

searchInput:OnChanged(function() refreshPlayerList() end)
Players.PlayerAdded:Connect(function() task.delay(0.2, refreshPlayerList) end)
Players.PlayerRemoving:Connect(function() task.delay(0.2, refreshPlayerList) end)

-- profile labels (updated when player selected)
local pNameLabel = ProfSec:Label({ Text = "No player selected", TextSize = 15 })
local pUserLabel = ProfSec:Label({ Text = "" })
local pStatusLabel = ProfSec:Label({ Text = "" })
local pIdLabel = ProfSec:Label({ Text = "User ID: —" })
local pAgeLabel = ProfSec:Label({ Text = "Account age: —" })
local pTeamLabel = ProfSec:Label({ Text = "Team: —" })
local pHealthLabel = ProfSec:Label({ Text = "Health: —" })
local pDistLabel = ProfSec:Label({ Text = "Distance: —" })

updateProfile = function()
    local p = selectedPlayer
    if not p or not p.Parent then
        pNameLabel:Set("No player selected")
        pUserLabel:Set(""); pStatusLabel:Set("")
        pIdLabel:Set("User ID: —"); pAgeLabel:Set("Account age: —")
        pTeamLabel:Set("Team: —"); pHealthLabel:Set("Health: —"); pDistLabel:Set("Distance: —")
        return
    end
    pNameLabel:Set(p.DisplayName)
    pUserLabel:Set("@" .. p.Name)
    local st = statusOf(p)
    pStatusLabel:Set("Status: " .. st)
    pIdLabel:Set("User ID: " .. tostring(p.UserId))
    pAgeLabel:Set("Account age: " .. fmtAge(p.AccountAge))
    local ch = p.Character; local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    pTeamLabel:Set("Team: " .. (p.Team and p.Team.Name or "None"))
    pHealthLabel:Set("Health: " .. (hum and (math.floor(hum.Health + 0.5) .. " / " .. math.floor(hum.MaxHealth + 0.5)) or "—"))
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    local mhrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    pDistLabel:Set("Distance: " .. ((hrp and mhrp) and (math.floor((hrp.Position - mhrp.Position).Magnitude) .. " studs") or "—"))
end

-- action buttons
local _friendBtn = ProfSec:Button({ Title = "Make Friendly", Callback = function()
    local p = selectedPlayer; if not p then return end
    if statusOf(p) == "Friendly" then statusById[p.UserId] = nil; notify(p.Name .. " is now neutral", 2)
    else statusById[p.UserId] = "Friendly"; notify(p.Name .. " marked friendly", 2) end
    updateProfile()
end})
ProfSec:Button({ Title = "Teleport", Callback = function()
    local p = selectedPlayer; if not p then return end
    local thrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
    local mhrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not (thrp and mhrp) then notify("Teleport failed: character missing", 3); return end
    mhrp.CFrame = thrp.CFrame * CFrame.new(0, 0, 3); notify("Teleported to " .. p.Name, 2)
end})
ProfSec:Button({ Title = "Spectate / Stop", Callback = function()
    if spectating then
        spectating = nil; local mc = lp.Character; local h = mc and mc:FindFirstChildOfClass("Humanoid")
        if h then cam.CameraSubject = h end; notify("Stopped spectating", 2); updateProfile(); return
    end
    local p = selectedPlayer
    local h = p and p.Character and p.Character:FindFirstChildOfClass("Humanoid")
    if not h then notify("Spectate failed: no character", 3); return end
    spectating = p; cam.CameraSubject = h; notify("Spectating " .. p.Name, 2); updateProfile()
end})
ProfSec:Button({ Title = "Copy Username", Callback = function()
    local p = selectedPlayer; if not p then return end
    local ok = pcall(function() (setclipboard or toclipboard)(p.Name) end)
    notify(ok and ("Copied " .. p.Name) or "Clipboard not supported", 2)
end})

-- live update profile
task.spawn(function()
    local tick_ = 0
    while true do
        local dt = RunService.Heartbeat:Wait()
        if spectating then
            if not spectating.Parent then spectating = nil
            else
                local sh = spectating.Character and spectating.Character:FindFirstChildOfClass("Humanoid")
                if sh and cam.CameraSubject ~= sh then cam.CameraSubject = sh end
            end
        end
        tick_ += dt
        if tick_ >= 0.2 then tick_ = 0; if selectedPlayer then updateProfile() end end
    end
end)

